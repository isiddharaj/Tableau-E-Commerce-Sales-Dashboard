              <calculation class='tableau' formula='IF SUM([Calculation_1680098868617233])-SUM([YTD Sales (copy)_1512423905447936])&lt;0 THEN &apos;Less than PY&apos;&#13;&#10;ELSEIF SUM([Calculation_1680098868617233])-SUM([YTD Sales (copy)_1512423905447936])&gt;0 THEN &apos;Greater than PY&apos;&#13;&#10;ELSEIF  ISNULL(SUM([YTD Sales (copy)_1512423905447936])) THEN &apos;No Sales in PY&apos;&#13;&#10;END' />
            </column>
            <column caption='Positive % Diff' datatype='string' name='[Calculation_1512423908757507]' role='measure' type='nominal'>
