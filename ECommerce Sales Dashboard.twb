      <column caption='% Diffrrence' datatype='real' name='[Calculation_1512423905767425]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='(SUM([Calculation_1680098868617233])-SUM([YTD Sales (copy)_1512423905447936]))/SUM([YTD Sales (copy)_1512423905447936])' />
      </column>
      <column caption='Sales Margin' datatype='string' name='[Calculation_1512423907237890]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF SUM([Calculation_1680098868617233])-SUM([YTD Sales (copy)_1512423905447936])&lt;0 THEN &apos;Less than PY&apos;&#13;&#10;ELSEIF SUM([Calculation_1680098868617233])-SUM([YTD Sales (copy)_1512423905447936])&gt;0 THEN &apos;Greater than PY&apos;&#13;&#10;ELSEIF  ISNULL(SUM([YTD Sales (copy)_1512423905447936])) THEN &apos;No Sales in PY&apos;&#13;&#10;END' />
      </column>
      <column caption='Positive % Diff' datatype='string' name='[Calculation_1512423908757507]' role='measure' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_1512423905767425]&gt;0 THEN &apos;▲&apos; END' />
      </column>
      <column caption='Negative % Diff' datatype='string' name='[Calculation_1512423909367812]' role='measure' type='nominal'>
