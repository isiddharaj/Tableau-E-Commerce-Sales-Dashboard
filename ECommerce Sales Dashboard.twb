      </column>
      <column caption='No Sales' datatype='string' name='[Calculation_1512423909847045]' role='measure' type='nominal'>
        <calculation class='tableau' formula='if [Calculation_1512423907237890]=&apos;No Sales in PY&apos; THEN &apos;No Sales in PY&apos; END' />
      </column>
      <column caption='YTD Sales LOD' datatype='real' name='[Calculation_1680098308341760]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM(IF YEAR([Order Date])= { MAX(YEAR([Order Date]))} THEN [Sales] END )}' />
      </column>
      <column caption='YOY Sales%' datatype='real' name='[Calculation_1680098310340610]' role='measure' type='quantitative'>
